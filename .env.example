# Source2Study Configuration
# Copy this file to .env in your backend directory and fill in your values

# Application Branding
APP_NAME=Source2Study
FRONTEND_URL=http://localhost:3000

# Database (SQLite default - no setup needed)
DATABASE_URL=sqlite:///./studymind.db

# JWT Secret Key (change in production!)
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email Verification & Password Reset (SMTP Configuration)
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-16-character-google-app-password
#   SMTP_FROM_EMAIL=your-email@gmail.com
#   SMTP_FROM_NAME=Source2Study Support
#   SMTP_TLS=True
#   SMTP_SSL=False
# Example for Outlook/Office365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_TLS=True
#   SMTP_SSL=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@source2study.com
SMTP_FROM_NAME=Source2Study Support
SMTP_TLS=True
SMTP_SSL=False
# Set to True only for automated unit tests without real mail server access
SMTP_ALLOW_DEV_FALLBACK=False

# Token Expiry Hours
VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESET_PASSWORD_TOKEN_EXPIRE_HOURS=1

# Tesseract OCR Path (Auto-detected on Windows if installed at standard paths)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Google Gemini API Key (Required for AI features)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini text generation models
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# File Upload Settings
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_db
MAX_FILE_SIZE_MB=50

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Duplicate Detection Threshold (0.5 to 1.0, recommended 0.82)
SIMILARITY_THRESHOLD=0.82

# CORS (frontend URL)
CORS_ORIGINS=["http://localhost:3000"]
