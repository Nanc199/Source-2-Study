# StudyMind AI Configuration
# Copy this file to .env and fill in your values

# Database (SQLite default - no setup needed)
DATABASE_URL=sqlite:///./studymind.db

# JWT Secret Key (change in production!)
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Google Gemini API Key (Required for AI features)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini text generation model (override if this model is unavailable to your API key)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# File Upload Settings
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_db
MAX_FILE_SIZE_MB=50

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Duplicate Detection Threshold (0.5 to 1.0)
SIMILARITY_THRESHOLD=0.85

# CORS (frontend URL)
CORS_ORIGINS=["http://localhost:3000"]
